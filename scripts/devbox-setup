#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'USAGE'
Usage:
  devbox-setup                         Run the interactive onboarding
  devbox-setup git [--name NAME --email EMAIL]
  devbox-setup github [--with-token]  Authenticate with GitHub (token is read from stdin)
  devbox-setup tailscale [--hostname NAME] [--auth-key KEY]
  devbox-setup ssh --key PUBLIC_KEY [--disable-password-auth]
  devbox-setup 1password [--service-token TOKEN]
  devbox-setup 1password --account ADDRESS EMAIL SECRET_KEY [SHORTHAND]
  devbox-setup --op ITEM              Run setup from a 1Password item

The SSH command adds a validated public key for regular OpenSSH logins (ssh
user@host). Tailscale SSH does not need a key; it trusts your tailnet identity.
Password authentication is changed only when --disable-password-auth is
explicitly supplied and a valid key is already present in
~/.ssh/authorized_keys.

1Password: --service-token takes a service account token (ops_...) and
--account takes full account details. With --op, devbox-setup reads the item
(found by name, e.g. "DevBox Setup" or an op://VAULT/ITEM reference) and runs
Git, GitHub, Tailscale, and SSH setup from its fields: git-name, git-email,
gh-token, ts-token, ts-host, ssh-key. See docs/1password.md.
USAGE
}

die() {
  echo "devbox-setup: $*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

prompt() {
  local message="$1" value
  [[ -r /dev/tty ]] || die "interactive input requires a terminal"
  printf '%s' "$message" >/dev/tty
  IFS= read -r value </dev/tty
  printf '%s' "$value"
}

secret_prompt() {
  local message="$1" value
  [[ -r /dev/tty ]] || die "interactive input requires a terminal"
  printf '%s' "$message" >/dev/tty
  stty -echo
  IFS= read -r value </dev/tty
  stty echo
  printf '\n' >/dev/tty
  printf '%s' "$value"
}

confirm() {
  local answer
  [[ -r /dev/tty ]] || return 1
  printf '%s [y/N] ' "$1" >/dev/tty
  IFS= read -r answer </dev/tty
  [[ "$answer" == [yY] || "$answer" == [yY][eE][sS] ]]
}

setup_git() {
  local name="" email=""
  while (($#)); do
    case "$1" in
      --name) name="${2:-}"; shift 2 ;;
      --email) email="${2:-}"; shift 2 ;;
      *) die "unknown git option: $1" ;;
    esac
  done

  need git
  name="${name:-$(git config --global user.name 2>/dev/null || true)}"
  email="${email:-$(git config --global user.email 2>/dev/null || true)}"
  name="${name:-$(prompt 'Git name: ')}"
  email="${email:-$(prompt 'Git email: ')}"
  [[ -n "$name" && -n "$email" ]] || die "both Git name and email are required"
  git config --global user.name "$name"
  git config --global user.email "$email"
  echo "✓ Git identity configured for $name <$email>"
}

setup_github() {
  local with_token=0
  while (($#)); do
    case "$1" in
      --with-token) with_token=1; shift ;;
      *) die "unknown github option: $1" ;;
    esac
  done

  need gh
  if gh auth status --hostname github.com >/dev/null 2>&1; then
    echo "✓ GitHub is already authenticated"
    return
  fi

  if ((with_token)); then
    gh auth login --hostname github.com --git-protocol https --with-token
  else
    [[ -t 0 || -r /dev/tty ]] || die "run this command from a terminal, or pipe a token to: devbox-setup github --with-token"
    gh auth login --hostname github.com --git-protocol https --web
  fi
  gh auth setup-git
  echo "✓ GitHub authentication configured"
}

valid_hostname() {
  [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]]
}

setup_tailscale() {
  local hostname="" auth_key=""
  while (($#)); do
    case "$1" in
      --hostname) hostname="${2:-}"; shift 2 ;;
      --auth-key) auth_key="${2:-}"; shift 2 ;;
      *) die "unknown tailscale option: $1" ;;
    esac
  done

  need tailscale
  hostname="${hostname:-$(hostname -s)}"
  valid_hostname "$hostname" || die "invalid Tailscale hostname: $hostname"

  local args=(up --ssh --accept-routes "--hostname=$hostname")
  [[ -z "$auth_key" ]] || args+=("--auth-key=$auth_key")
  sudo tailscale "${args[@]}"
  echo "✓ Tailscale connected as $hostname with Tailscale SSH enabled"
}

validate_public_key() {
  local key="$1" key_file status
  key_file="$(mktemp)"
  printf '%s\n' "$key" >"$key_file"
  if ssh-keygen -l -f "$key_file" >/dev/null 2>&1; then
    status=0
  else
    status=1
  fi
  rm -f "$key_file"
  return "$status"
}

authorized_keys_has_valid_key() {
  local line
  [[ -r "$HOME/.ssh/authorized_keys" ]] || return 1
  while IFS= read -r line; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    if validate_public_key "$line"; then
      return 0
    fi
  done <"$HOME/.ssh/authorized_keys"
  return 1
}

disable_password_ssh() {
  authorized_keys_has_valid_key ||
    die "refusing to disable password SSH: no valid key is present in ~/.ssh/authorized_keys"

  # OpenSSH uses the first value it encounters. Debian/Ubuntu include this
  # directory near the top of sshd_config, so sort before vendor/cloud files.
  local dropin="/etc/ssh/sshd_config.d/00-devbox-key-only.conf"
  local candidate backup=""
  candidate="$(mktemp)"
  printf '%s\n' \
    '# Installed explicitly by devbox-setup ssh --disable-password-auth' \
    'PasswordAuthentication no' \
    'KbdInteractiveAuthentication no' >"$candidate"

  if sudo test -e "$dropin"; then
    backup="$(mktemp)"
    sudo cp "$dropin" "$backup"
  fi

  sudo install -o root -g root -m 0644 "$candidate" "$dropin"
  if ! sudo sshd -t ||
    ! sudo sshd -T | grep -qx 'passwordauthentication no' ||
    ! sudo sshd -T | grep -qx 'kbdinteractiveauthentication no'; then
    if [[ -n "$backup" ]]; then
      sudo install -o root -g root -m 0644 "$backup" "$dropin"
      rm -f "$backup"
    else
      sudo rm -f "$dropin"
    fi
    rm -f "$candidate"
    die "OpenSSH rejected the configuration; the previous configuration was restored"
  fi
  [[ -z "$backup" ]] || rm -f "$backup"
  rm -f "$candidate"
  sudo systemctl reload ssh
  echo "✓ Password and keyboard-interactive SSH authentication disabled"
}

setup_ssh() {
  local key="" disable_password=0
  while (($#)); do
    case "$1" in
      --key) key="${2:-}"; shift 2 ;;
      --disable-password-auth) disable_password=1; shift ;;
      *) die "unknown ssh option: $1" ;;
    esac
  done

  need ssh-keygen
  key="${key:-$(prompt 'SSH public key (for regular OpenSSH logins, not Tailscale SSH): ')}"
  [[ -n "$key" ]] || die "an SSH public key is required"
  validate_public_key "$key" || die "invalid SSH public key"

  install -d -m 0700 "$HOME/.ssh"
  touch "$HOME/.ssh/authorized_keys"
  chmod 0600 "$HOME/.ssh/authorized_keys"
  if ! grep -qxF "$key" "$HOME/.ssh/authorized_keys"; then
    printf '%s\n' "$key" >>"$HOME/.ssh/authorized_keys"
  fi
  echo "✓ SSH public key installed"

  if ((disable_password)); then
    disable_password_ssh
  fi
}

setup_1password() {
  local token="" account_mode=0 address="" email="" secret_key="" shorthand=""
  while (($#)); do
    case "$1" in
      --service-token) token="${2:-}"; shift 2 ;;
      --account) account_mode=1; address="${2:-}"; email="${3:-}"; secret_key="${4:-}"; shorthand="${5:-}"; shift 5 ;;
      *) die "unknown 1password option: $1" ;;
    esac
  done

  need op
  if op whoami >/dev/null 2>&1; then
    echo "✓ 1Password is already authenticated"
    return
  fi

  if ((account_mode)); then
    setup_1password_account "$address" "$email" "$secret_key" "$shorthand"
    return
  fi

  if [[ -z "$token" ]]; then
    echo "1Password service accounts are created at 1Password.com under Developer → Service Accounts."
    echo "The token looks like ops_eyJ... and grants the CLI scoped, revocable access."
    token="$(secret_prompt '1Password service token: ')"
  fi
  [[ -n "$token" ]] || die "a 1Password service token is required"

  export OP_SERVICE_ACCOUNT_TOKEN="$token"
  if ! op whoami >/dev/null 2>&1; then
    die "1Password rejected the service token"
  fi

  if confirm "Persist the token in ~/.config/shell/envs so future login sessions can use it?"; then
    persist_op_service_token "$token"
  fi

  echo "✓ 1Password service account configured"
  echo "With op authenticated you can also seed all other setup from one item: devbox-setup --op 'DevBox Setup'"
}

persist_op_service_token() {
  local token="$1" env_file="$HOME/.config/shell/envs" line
  line="export OP_SERVICE_ACCOUNT_TOKEN=\"$token\""
  mkdir -p "$(dirname "$env_file")"
  if [[ -f "$env_file" ]] && grep -q '^export OP_SERVICE_ACCOUNT_TOKEN=' "$env_file"; then
    sed -i "s|^export OP_SERVICE_ACCOUNT_TOKEN=.*|$line|" "$env_file"
  else
    printf '%s\n' "$line" >>"$env_file"
  fi
  chmod 600 "$env_file"
}

setup_1password_account() {
  local address="${1:-}" email="${2:-}" secret_key="${3:-}" shorthand="${4:-}" password="" session

  address="${address:-$(prompt '1Password sign-in address (e.g. yourname.1password.com): ')}"
  email="${email:-$(prompt '1Password email: ')}"
  secret_key="${secret_key:-$(secret_prompt '1Password secret key: ')}"
  shorthand="${shorthand:-$(prompt 'Account shorthand (optional): ')}"
  password="$(secret_prompt '1Password password: ')"
  [[ -n "$address" && -n "$email" && -n "$secret_key" && -n "$password" ]] || die "all account details are required"

  local account_args=()
  if ! op account list --format json 2>/dev/null | jq -e 'length > 0' >/dev/null 2>&1; then
    account_args=(account add --address "$address" --email "$email" --secret-key "$secret_key" --signin)
    [[ -n "$shorthand" ]] && account_args+=(--shorthand "$shorthand")
    session="$(printf '%s\n' "$password" | op "${account_args[@]}")" || die "1Password sign-in failed"
  else
    account_args=(signin)
    if [[ -n "$shorthand" ]]; then
      account_args+=(--account "$shorthand")
    elif [[ -n "$address" ]]; then
      account_args+=(--account "$address")
    fi
    session="$(printf '%s\n' "$password" | op "${account_args[@]}")" || die "1Password sign-in failed"
  fi

  eval "$session"
  echo "✓ 1Password account configured"
}

op_item_field() {
  printf '%s' "$1" | jq -r --arg field "$2" '
    (.fields // []) |
    (
      map(select((.section? == null) and (.label == $field or .id == $field))) +
      map(select(.label == $field or .id == $field))
    ) |
    .[0].value // empty
  '
}

setup_from_op() {
  local item="${1:-}" json
  [[ -n "$item" ]] || die "--op requires a 1Password item reference"
  need op
  need jq

  echo "Reading DevBox setup fields from 1Password item: $item"
  if [[ $item == op://* ]]; then
    json="$(op item get "${item#op://}" --format json 2>/dev/null)" || die "could not read 1Password item: $item"
  else
    json="$(op item get "$item" --format json 2>/dev/null)" || die "could not read 1Password item: $item"
  fi

  local git_name git_email gh_token ts_token ts_host ssh_key applied=0
  git_name="$(op_item_field "$json" git-name)"
  git_email="$(op_item_field "$json" git-email)"
  gh_token="$(op_item_field "$json" gh-token)"
  ts_token="$(op_item_field "$json" ts-token)"
  ts_host="$(op_item_field "$json" ts-host)"
  ssh_key="$(op_item_field "$json" ssh-key)"

  if [[ -n "$git_name" || -n "$git_email" ]]; then
    if [[ -n "$git_name" && -n "$git_email" ]]; then
      setup_git --name "$git_name" --email "$git_email"; applied=1
    else
      die "the 1Password item must set both git-name and git-email"
    fi
  fi
  if [[ -n "$gh_token" ]]; then
    printf '%s' "$gh_token" | setup_github --with-token; applied=1
  fi
  if [[ -n "$ts_token" ]]; then
    setup_tailscale --hostname "${ts_host:-$(hostname -s)}" --auth-key "$ts_token"; applied=1
  fi
  if [[ -n "$ssh_key" ]]; then
    setup_ssh --key "$ssh_key"; applied=1
  fi

  if ((applied == 0)); then
    die "the 1Password item has no recognized DevBox fields"
  fi
  echo "✓ DevBox setup applied from 1Password"
}

interactive_setup() {
  echo "Devbox service onboarding"
  echo
  if [[ -n "$(git config --global --get user.name 2>/dev/null || true)" && -n "$(git config --global --get user.email 2>/dev/null || true)" ]]; then
    echo "✓ Git identity is already configured"
  elif confirm "Configure Git identity?"; then
    setup_git
  fi
  if command -v gh >/dev/null 2>&1 && gh auth status --hostname github.com >/dev/null 2>&1; then
    echo "✓ GitHub is already authenticated"
  elif confirm "Authenticate with GitHub?"; then
    setup_github
  fi
  if command -v tailscale >/dev/null 2>&1 && tailscale ip -4 >/dev/null 2>&1; then
    echo "✓ Tailscale is already connected"
  elif command -v tailscale >/dev/null 2>&1 && confirm "Connect Tailscale and enable Tailscale SSH?"; then
    setup_tailscale
  fi
  if authorized_keys_has_valid_key; then
    echo "✓ An SSH public key is already installed"
  elif confirm "Add an SSH public key for regular OpenSSH logins (not Tailscale SSH)?"; then
    setup_ssh
  fi
  if command -v op >/dev/null 2>&1 && op whoami >/dev/null 2>&1; then
    echo "✓ 1Password is already authenticated"
  elif command -v op >/dev/null 2>&1 && confirm "Authenticate with 1Password?"; then
    setup_1password
  fi
  if command -v tailscale >/dev/null 2>&1 && ! tailscale ip -4 >/dev/null 2>&1; then
    echo
    echo "Tailscale is installed but not connected. Run: sudo tailscale up"
    echo "(devbox-setup tailscale with an auth key, or --op, can do this for you.)"
  fi
  echo
  echo "Onboarding complete."
}

command="${1:-}"
[[ -z "$command" ]] || shift
case "$command" in
  "") interactive_setup ;;
  git) setup_git "$@" ;;
  github) setup_github "$@" ;;
  tailscale) setup_tailscale "$@" ;;
  ssh) setup_ssh "$@" ;;
  1password) setup_1password "$@" ;;
  --op) setup_from_op "${1:-}" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
