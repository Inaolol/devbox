# Native Debian/Ubuntu additions to the upstream Omadots shell configuration.
export LANG="${LANG:-C.UTF-8}"
export PATH="$HOME/.local/bin:$PATH"

# Omadots runs aliases before inits, so mise-installed eza and zoxide are not
# yet on PATH when Omadots checks for them. Define their aliases here after
# Omadots has activated mise.
if command -v eza >/dev/null 2>&1; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi

if command -v zoxide >/dev/null 2>&1; then
  alias cd='zd'
  zd() {
    if (( $# == 0 )); then
      builtin cd ~ || return
    elif [[ -d $1 ]]; then
      builtin cd "$1" || return
    else
      if ! z "$@"; then
        echo "Error: Directory not found"
        return 1
      fi
      printf '\U000F17A9 '
      pwd
    fi
  }
fi

n() {
  if (( $# == 0 )); then
    command nvim .
  else
    command nvim "$@"
  fi
}

alias d='lazydocker'
alias lzd='lazydocker'
alias h='herdr'
alias cls='clear'
alias dc='docker compose'
alias mup='MISE_MINIMUM_RELEASE_AGE=0 mise up'
alias agy='agy --dangerously-skip-permissions'
alias c='opencode --auto'
alias cy='codex --approve-for-me'
